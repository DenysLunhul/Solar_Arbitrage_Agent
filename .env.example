# Copy this file to .env and fill in the values

# When running via docker-compose use "db" as the host (service name)
# When running locally use "localhost:5433"
DATABASE_URL=postgresql://postgres:password@db:5432/postgres

POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=postgres

# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_EXPIRE_MINUTES=30

# Baked into the frontend bundle at build time (docker-compose frontend service).
# Must be the API URL as seen from the user's BROWSER.
VITE_API_URL=http://localhost:8000
